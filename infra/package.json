{
  "name": "@insips/infra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && cdk synth --quiet",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "synth": "cdk synth",
    "deploy": "cdk deploy --require-approval broadening",
    "destroy": "cdk destroy"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "2.35.0",
    "@aws-lambda-powertools/metrics": "2.35.0",
    "@aws-sdk/client-bedrock-runtime": "3.1136.0",
    "@aws-sdk/client-dynamodb": "3.1136.0",
    "@aws-sdk/client-s3": "3.1136.0",
    "@aws-sdk/client-sfn": "3.1136.0",
    "@aws-sdk/client-textract": "3.1136.0",
    "@aws-sdk/lib-dynamodb": "3.1136.0",
    "@aws-sdk/s3-presigned-post": "3.1136.0",
    "@insips/contracts": "workspace:*",
    "aws-cdk-lib": "2.270.0",
    "constructs": "10.8.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/aws-lambda": "8.10.163",
    "@types/node": "26.6.2",
    "aws-cdk": "2.1142.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.54.0",
    "vitest": "5.0.1"
  }
}
