# Public web origin, for example http://localhost:3000 in local development.
NEXT_PUBLIC_APP_URL=

# local uses synthetic fixtures; aws requires deployed Cognito and API values.
INSIPS_DATA_MODE=local

# Populated from CDK outputs after an approved AWS deployment.
NEXT_PUBLIC_AWS_REGION=
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_USER_POOL_CLIENT_ID=
NEXT_PUBLIC_COGNITO_DOMAIN=
NEXT_PUBLIC_API_BASE_URL=

# Set only after verifying an available Bedrock text model in the chosen region.
BEDROCK_MODEL_ID=

# Deployment-time cost controls. Do not invent values.
INSIPS_BUDGET_USD=
INSIPS_BUDGET_EMAIL=
